{
  "manifest_version": 3,
  "name": "Better LinkedIn: Enhance your LinkedIn\u2122 feed",
  "version": "3.0.1",
  "description": "Improve your LinkedIn\u2122 feed by automatically removing unwanted posts.",
  "author": "Facundo Martínez",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/",
        "https://www.linkedin.com/feed*",
        "https://www.linkedin.com/feed/*"
      ],
      "js": [
        "utils/i18n.js",
        "content-feed.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "utils/i18n.js",
        "content-jobs.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "utils/i18n.js",
        "content-profile.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better LinkedIn Settings"
  },
  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better_linkedin_v1.0.0@biocoder.dev"
    }
  }
}